# syntax=docker/dockerfile:1.7

# =============================================================================
#  Open Web Catcher - Puppeteer tools container
#  Processes: Chrome (shared fallback) + Node MCP server
# =============================================================================

FROM node:20-bookworm-slim

ARG BUILDKIT_INLINE_CACHE=1

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    PUPPETEER_CACHE_DIR=/opt/puppeteer \
    PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/google-chrome-stable \
    PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    OWC_UBOL_ENABLED=true \
    OWC_UBOL_EXTENSION_DIR=/app/tools/puppeteer/extensions/ubol \
    OWC_UBOL_DEFAULT_FILTERING=optimal \
    MCP_BROWSER_MODE=isolated \
    BROWSER_WS_ENDPOINT=ws://127.0.0.1:9222

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    unzip \
    ca-certificates \
    supervisor \
    fonts-noto-core \
    fonts-noto-extra \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libvulkan1 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    fontconfig \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

COPY tools/puppeteer/package*.json tools/puppeteer/
RUN --mount=type=cache,target=/root/.npm \
    cd tools/puppeteer \
    && npm ci --omit=dev --prefer-offline --no-audit --no-fund \
    && npx --yes @puppeteer/browsers install chrome@stable --path /opt/puppeteer \
    && CHROME_BIN="$(find /opt/puppeteer/chrome -type f -path '*/chrome-linux64/chrome' | head -n 1)" \
    && test -n "${CHROME_BIN}" \
    && ln -sf "${CHROME_BIN}" /usr/local/bin/google-chrome-stable \
    && ln -sf /usr/local/bin/google-chrome-stable /usr/local/bin/google-chrome \
    && curl -fsSL https://api.github.com/repos/uBlockOrigin/uBOL-home/releases/latest -o /tmp/ubol-release.json \
    && UBOL_ASSET_URL="$(node -e "const fs=require('fs'); const payload=JSON.parse(fs.readFileSync('/tmp/ubol-release.json','utf8')); const asset=(payload.assets||[]).find((entry)=>/chromium.*\\.zip$/i.test(String(entry.name||''))); if(!asset?.browser_download_url){console.error('No Chromium uBOL asset found in latest release'); process.exit(1);} process.stdout.write(asset.browser_download_url);")" \
    && test -n "${UBOL_ASSET_URL}" \
    && mkdir -p /app/tools/puppeteer/extensions/ubol \
    && curl -fsSL "${UBOL_ASSET_URL}" -o /tmp/ubol.zip \
    && unzip -q /tmp/ubol.zip -d /app/tools/puppeteer/extensions/ubol \
    && rm -f /tmp/ubol.zip /tmp/ubol-release.json \
    && test -f /app/tools/puppeteer/extensions/ubol/manifest.json \
    && test -f /app/tools/puppeteer/extensions/ubol/rulesets/ruleset-details.json

COPY tools/puppeteer/ tools/puppeteer/
COPY tools/shared/ tools/shared/
COPY configs/supervisord.tools.conf /etc/supervisor/conf.d/owc.conf
COPY scripts/ scripts/

RUN mkdir -p data/logs \
    && chmod +x scripts/docker/entrypoint.sh

EXPOSE 3000 9222

ENTRYPOINT ["scripts/docker/entrypoint.sh"]
