# syntax=docker/dockerfile:1.7

# =============================================================================
#  Open Web Catcher - Playwright tools container
#  Processes: Chrome (shared fallback) + Node MCP server (port 3001)
# =============================================================================

# Base pinned to Playwright 1.60.0 on noble.
# Digest pin placeholder (resolve with: docker buildx imagetools inspect mcr.microsoft.com/playwright:v1.60.0-noble
# then append @sha256:<digest> to the FROM line below):
#   mcr.microsoft.com/playwright:v1.60.0-noble@sha256:<TO_FILL_AFTER_VERIFYING>
FROM mcr.microsoft.com/playwright:v1.60.0-noble

ARG BUILDKIT_INLINE_CACHE=1

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_EXECUTABLE_PATH=/usr/local/bin/google-chrome-stable \
    PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/google-chrome-stable \
    OWC_UBOL_ENABLED=true \
    OWC_UBOL_EXTENSION_DIR=/app/tools/playwright/extensions/ubol \
    OWC_UBOL_EXTENSION_ID=nkeimhogjdpnpccoofpliimaahmaaome \
    OWC_UBOL_DEFAULT_FILTERING=optimal \
    MCP_BROWSER_MODE=isolated \
    BROWSER_WS_ENDPOINT=ws://127.0.0.1:9223 \
    REMOTE_DEBUGGING_PORT=9223 \
    PORT=3001 \
    OWC_BROWSER_HEADLESS=true

# Internal headless default stays true; only profile-gated deployments
# (owc-tools-playwright-headed in docker-compose.yml) set it to false so the
# entrypoint launches Chrome under Xvfb instead of --headless=new.

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl socat unzip xvfb x11-utils \
    && rm -rf /var/lib/apt/lists/*

COPY tools/playwright/package*.json tools/playwright/
RUN --mount=type=cache,target=/root/.npm \
    cd tools/playwright \
    && npm ci --omit=dev --prefer-offline --no-audit --no-fund \
    # CVE-2026-59873 (critical): npm tar <=7.5.18 resource exhaustion; forced
    # to the patched release until upstream deps move (plan T47 audit pass).
    && npm install --omit=dev --no-save --no-audit --no-fund tar@^7.5.19 \
    && CHROME_BIN="$(find /ms-playwright -type f \( -path '*/chrome-linux64/chrome' -o -path '*/chrome-linux/chrome' \) | head -n 1)" \
    && test -n "${CHROME_BIN}" \
    && ln -sf "${CHROME_BIN}" /usr/local/bin/google-chrome-stable \
    && ln -sf /usr/local/bin/google-chrome-stable /usr/local/bin/google-chrome \
    && curl -fsSL 'https://api.github.com/repos/uBlockOrigin/uBOL-home/releases?per_page=10' -o /tmp/ubol-releases.json \
    && UBOL_ASSET_URL="$(node -e "const fs=require('fs'); const releases=JSON.parse(fs.readFileSync('/tmp/ubol-releases.json','utf8')); const pick=(rows, includePrerelease)=>rows.filter((release)=>!release.draft && (includePrerelease || !release.prerelease)).flatMap((release)=>(release.assets||[]).map((asset)=>({ ...asset, release_tag: release.tag_name }))).find((asset)=>/chromium.*\\.zip$/i.test(String(asset.name||''))); const asset=pick(releases,false) || pick(releases,true); if(!asset?.browser_download_url){console.error('No Chromium uBOL asset found in recent releases'); process.exit(1);} process.stdout.write(asset.browser_download_url);")" \
    && test -n "${UBOL_ASSET_URL}" \
    && mkdir -p /app/tools/playwright/extensions/ubol \
    && curl -fsSL "${UBOL_ASSET_URL}" -o /tmp/ubol.zip \
    && unzip -q /tmp/ubol.zip -d /app/tools/playwright/extensions/ubol \
    && rm -f /tmp/ubol.zip /tmp/ubol-releases.json \
    && test -f /app/tools/playwright/extensions/ubol/manifest.json \
    && test -f /app/tools/playwright/extensions/ubol/rulesets/ruleset-details.json

COPY tools/playwright/ tools/playwright/
COPY tools/shared/ tools/shared/
COPY scripts/ scripts/

# Non-root runtime user, created after every root-requiring step
# (apt, npm ci with /root/.npm cache mount, /usr/local/bin Chrome symlinks,
# uBOL download into tools/playwright/extensions/ubol).
# CVE hygiene (plan T47): the distro npm bundles tar@7.5.11 (CVE-2026-59873,
# critical). npm has finished all build-time work by this layer, so strip its
# vendored vulnerable tree from the final image; runtime only needs node.
RUN groupadd --system --gid 10001 app \
    && rm -rf /usr/lib/node_modules/npm/node_modules/tar \
    && useradd --system --uid 10001 --gid app --home-dir /home/app --create-home --shell /bin/bash app

# Runtime-writable paths owned by app: data tree (logs under data/logs), the
# Chrome managed-policy dirs written by prepare_ubol_policy() in the entrypoint.
# Shared Chrome writes its temporary profile under /tmp; persistent Playwright
# jars live under /app/data/browser-state. Browsers under
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright are read-only at runtime (launch only).
RUN mkdir -p data/logs \
    && chmod +x scripts/docker/entrypoint.playwright.sh \
    && mkdir -p /etc/opt/chrome/policies/managed /etc/chromium/policies/managed \
    && chown -R app:app /etc/opt/chrome /etc/chromium \
    && chown -R app:app /app/data

EXPOSE 3001 9223 9224

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:3001/health').then((r)=>{if(!r.ok)process.exit(1);return r.text();}).then((t)=>{if(!t.includes('\"status\":\"ok\"'))process.exit(1);}).catch(()=>process.exit(1))"

USER app

ENTRYPOINT ["scripts/docker/entrypoint.playwright.sh"]
