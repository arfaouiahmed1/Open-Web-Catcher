# syntax=docker/dockerfile:1.7

# =============================================================================
#  Open Web Catcher - Playwright tools container
#  Processes: Chrome (shared fallback) + Node MCP server (port 3001)
# =============================================================================

FROM node:20-bookworm-slim

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    MCP_BROWSER_MODE=isolated \
    BROWSER_WS_ENDPOINT=ws://127.0.0.1:9223 \
    PORT=3001

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    bash \
    curl \
    ca-certificates \
    supervisor \
    fonts-noto-core \
    fonts-noto-extra \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libvulkan1 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    xdg-utils \
    fontconfig \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

COPY tools/playwright/package*.json tools/playwright/
RUN --mount=type=cache,target=/root/.npm \
    cd tools/playwright \
    && npm install --omit=dev --prefer-offline --no-audit --no-fund \
    && PLAYWRIGHT_BROWSERS_PATH=/opt/playwright npx playwright install chromium --with-deps \
    && CHROME_BIN="$(find /opt/playwright -type f -name 'chrome' | head -n 1)" \
    && test -n "${CHROME_BIN}" \
    && ln -sf "${CHROME_BIN}" /usr/local/bin/google-chrome-stable \
    && ln -sf /usr/local/bin/google-chrome-stable /usr/local/bin/google-chrome

COPY tools/playwright/ tools/playwright/
COPY configs/supervisord.playwright.conf /etc/supervisor/conf.d/owc.conf
COPY scripts/ scripts/

RUN mkdir -p data/logs \
    && chmod +x scripts/docker/entrypoint.sh

EXPOSE 3001 9223

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -fs http://localhost:3001/health | grep -q '"status":"ok"' || exit 1

ENTRYPOINT ["scripts/docker/entrypoint.sh"]
