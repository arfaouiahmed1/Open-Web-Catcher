      "proof_fields": ["before_screenshot_ref", "access_state", "media_state"],
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": { "type": "string", "enum": ["viewport", "full", "element"], "default": "viewport" },
          "candidate_id": { "type": "string", "description": "Required when scope=element" },
          "frame_path": { "type": "string", "default": "root" },
          "lossless": { "type": "boolean", "default": false, "description": "Use PNG instead of WebP; only for OCR" },
          "intent": { "type": "string", "maxLength": 200 }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/ToolEnvelopeV2"
      }
    },
    {
      "name": "harvest",
      "kind": "mcp",
      "description": "Discover media streams from the always-on network ledger plus DOM video/source scan, iframe scan, player-library inspection, performance entries, and popup-decoded targets. Parses HLS and DASH manifests. Probes each manifest with HEAD then Range: bytes=0-65535. Returns stream URLs with protocol, quality, codecs, encryption hints, expiry, and discovery layer metadata.",
      "mutates_page": false,
      "cacheable": false,
      "profiles": ["hosting", "embedded"],
      "annotations": {
        "readOnlyHint": true,
