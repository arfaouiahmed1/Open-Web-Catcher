          "scroll_amount": { "type": "integer", "minimum": 1 },
          "drag_to": { "type": "string", "description": "Target candidate ref or CSS for drag" },
          "allow_coordinate_fallback": { "type": "boolean", "default": false },
          "expected_change": {
            "type": "string",
            "enum": ["auto", "navigation", "dom", "media", "network"],
            "default": "auto"
          },
          "intent": { "type": "string", "maxLength": 200 }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/ToolEnvelopeV2"
      }
    },
    {
      "name": "screenshot",
      "kind": "mcp",
      "description": "Capture a viewport, full-page, or element screenshot. Returns a blobref (content-addressed evidence store key), dimensions, and current media/access state. For vision-capable models the MCP image block is preserved; for text-only models only the blobref and ARIA/DOM visual_summary are returned.",
      "mutates_page": false,
      "cacheable": true,
      "profiles": ["classification", "landing", "hosting", "embedded"],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
