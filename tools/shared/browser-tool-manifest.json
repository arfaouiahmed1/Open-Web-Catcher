      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "frame_path": { "type": "string", "default": "root" },
          "include_expired": { "type": "boolean", "default": false },
          "probe_manifests": { "type": "boolean", "default": true },
          "intent": { "type": "string", "maxLength": 200 }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/ToolEnvelopeV2"
      }
    },
    {
      "name": "wait",
      "kind": "mcp",
      "description": "Wait for a specific condition before proceeding. Supports: duration (fixed ms delay), text_visible (text appears in DOM), text_gone (text disappears), selector_visible (CSS element visible), media_playing (readyState >= 3), network_quiet (no in-flight requests). Caps consecutive wait calls per repeated_tool_call_limit.",
      "mutates_page": false,
      "cacheable": false,
      "profiles": ["classification", "landing", "hosting", "embedded"],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "proof_fields": [],
      "inputSchema": {
        "type": "object",
        "required": ["condition"],
        "additionalProperties": false,
        "properties": {
          "condition": {
            "type": "string",
            "enum": ["duration", "text_visible", "text_gone", "selector_visible", "media_playing", "network_quiet"]
          },
          "value": {
            "type": "string",
            "description": "Text string or CSS selector for text_*/selector_visible conditions; absent for duration/network/media"
          },
          "frame_path": { "type": "string", "default": "root" },
          "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 60000, "default": 10000 },
          "poll_ms": { "type": "integer", "minimum": 100, "maximum": 5000, "default": 500 },
          "intent": { "type": "string", "maxLength": 200 }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/ToolEnvelopeV2"
      }
    },
    {
      "name": "memory_search",
      "kind": "langchain",
      "description": "Search the site-memory vector store for patterns previously observed on this host or related hosts. Returns ranked memory chunks with relevance scores. Available in all profiles; appended by AgentToolSession when memory is enabled.",
      "mutates_page": false,
      "cacheable": false,
