  "tools": [
    {
      "name": "navigate",
      "kind": "mcp",
      "description": "Navigate the browser to a URL, go back, or reload. Records every redirect attempt and captures before/after proof screenshots. Rejects unsafe destinations (file:, data:, javascript:, loopback, RFC1918, cloud-metadata). Returns access_state and challenge detection.",
      "mutates_page": true,
      "cacheable": false,
      "profiles": ["classification", "landing", "hosting", "embedded"],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "proof_fields": ["before_screenshot_ref", "after_screenshot_ref", "access_state", "observed_change"],
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "enum": ["goto", "back", "reload"] },
          "url": { "type": "string", "description": "Required when action=goto" },
          "wait_until": {
            "type": "string",
            "enum": ["commit", "domcontentloaded", "load", "networkidle"],
            "default": "domcontentloaded"
          },
          "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 60000, "default": 30000 },
          "challenge_policy": {
            "type": "string",
            "enum": ["detect", "wait_once"],
            "default": "detect"
          },
          "intent": { "type": "string", "maxLength": 200, "description": "Short model-authored reason for this navigation" }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/ToolEnvelopeV2"
      }
    },
    {
      "name": "inspect",
      "kind": "mcp",
      "description": "Read page state, elements, frames, or media from the current page. The server-side profile selects the appropriate reducer (general/landing/hosting/embedded); the model cannot change it. Returns only visible/accessibility-tree-derived content. Never returns scripts, styles, hidden text, or instruction-like page text.",
      "mutates_page": false,
      "cacheable": true,
      "profiles": ["classification", "landing", "hosting", "embedded"],
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "proof_fields": ["before_screenshot_ref"],
      "inputSchema": {
        "type": "object",
        "required": ["view"],
        "additionalProperties": false,
        "properties": {
          "view": { "type": "string", "enum": ["summary", "elements", "element", "frames", "media"] },
          "frame_path": { "type": "string", "default": "root" },
          "scope_ref": { "type": "string", "description": "Candidate/element ref to scope the inspection" },
          "role": { "type": "string", "description": "ARIA role filter for elements view" },
          "text": { "type": "string", "description": "Partial text filter for elements view" },
          "attribute": { "type": "string", "description": "Attribute name filter for elements view" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor": { "type": "string", "description": "Pagination cursor from previous response" },
          "include_screenshot": { "type": "boolean", "default": false },
          "intent": { "type": "string", "maxLength": 200 }
        }
      },
      "outputSchema": {
        "$ref": "#/$defs/ToolEnvelopeV2"
      }
    },
    {
      "name": "interact",
      "kind": "mcp",
      "description": "Perform a user interaction on a page element: click, fill, select, check, press, hover, scroll, drag, or play media. Resolves elements in order: candidate ref, ARIA role+name, scoped CSS, XPath, visible text, coordinates (only if explicitly allowed). Requires the expected change to be observed or returns an error.",
      "mutates_page": true,
      "cacheable": false,
      "profiles": ["classification", "landing", "hosting", "embedded"],
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "proof_fields": ["before_screenshot_ref", "after_screenshot_ref", "observed_change", "network_evidence"],
      "inputSchema": {
        "type": "object",
        "required": ["action"],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": ["click", "fill", "select", "check", "press", "hover", "scroll", "drag", "play"]
          },
          "candidate_id": { "type": "string", "description": "Candidate ref from an inspect response" },
          "frame_path": { "type": "string", "default": "root" },
          "role": { "type": "string" },
          "name": { "type": "string" },
          "css": { "type": "string" },
          "xpath": { "type": "string" },
          "text": { "type": "string" },
          "value": { "type": "string", "description": "Text value for fill" },
          "option": { "type": "string", "description": "Option value or label for select" },
