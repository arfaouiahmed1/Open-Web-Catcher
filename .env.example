# Copy this file to .env and fill in your values.

# ── LLM ───────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Models ────────────────────────────────────────────────────────────────────
# Orchestrator uses a smaller model for routing decisions
ORCHESTRATOR_MODEL=gemini-2.5-flash-lite-preview-05-20
# Sub-agents (classification, landing, hosting, embedded) use the full model
AGENT_MODEL=gemini-2.5-flash-preview-05-20

# ── LangSmith (tracing — set API key to activate) ─────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=open-web-catcher

# ── IPInfo (provider lookup — 50k req/month free without token) ───────────────
IPINFO_TOKEN=

# ── Cloudinary (screenshot hosting for visual evidence) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Internal services (set automatically in the container) ───────────────────
# These defaults match the single-container setup and rarely need changing.
# BROWSER_WS_ENDPOINT=ws://localhost:9222
# MCP_SERVER_URL=http://localhost:3000
# DATABASE_URL=postgresql+psycopg2://owc:owc@localhost:5432/owc

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
