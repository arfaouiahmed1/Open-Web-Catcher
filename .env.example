# Copy this file to .env and fill in your values.

# ── LLM ───────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Models ────────────────────────────────────────────────────────────────────
# Orchestrator uses a smaller model for routing decisions
ORCHESTRATOR_MODEL=gemini-2.5-flash-lite-preview-05-20
# Sub-agents (classification, landing, hosting, embedded) use the full model
AGENT_MODEL=gemini-2.5-flash-preview-05-20

# ── Docker image naming ───────────────────────────────────────────────────────
OWC_IMAGE=open-web-catcher
OWC_TAG=latest

# Phoenix (self-hosted via Docker Compose)
# Local Docker setup. Leave the API key empty for self-hosted Phoenix.
# `PHOENIX_COLLECTOR_ENDPOINT` is for local tools on your host.
# `PHOENIX_COLLECTOR_ENDPOINT_DOCKER` is what the `owc` container uses internally.
PHOENIX_TRACING=true
PHOENIX_PROJECT_NAME=open-web-catcher
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT_DOCKER=http://phoenix:6006
PHOENIX_UI_URL=http://localhost:6006
PHOENIX_API_KEY=

# Optional legacy LangSmith fallback if you ever switch away from Phoenix:
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=open-web-catcher
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_UI_URL=https://smith.langchain.com

# ── IPInfo (provider lookup — 50k req/month free without token) ───────────────
IPINFO_TOKEN=

# ── Cloudinary (screenshot hosting for visual evidence) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Internal services (set automatically in the container) ───────────────────
# These defaults match the single-container setup and rarely need changing.
# MCP_BROWSER_MODE=isolated
# BROWSER_WS_ENDPOINT=ws://localhost:9222
# MCP_SERVER_URL=http://localhost:3000
# DATABASE_URL=postgresql+psycopg2://owc:owc@localhost:5432/owc

# ── Logging ───────────────────────────────────────────────────────────────────
# Ghostery adblocker + filterlist cache
# OWC_GHOSTERY_NETWORK_FILTERING=true
# OWC_GHOSTERY_COSMETIC_FILTERING=true
# OWC_ADBLOCK_CACHE_DIR=data/cache/adblocker
# OWC_ADBLOCK_CACHE_TTL_MS=86400000
# OWC_ADBLOCK_FILTERLIST_FETCH_TIMEOUT_MS=15000

LOG_LEVEL=INFO
