# Copy this file to .env and fill in your values.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Supported: google | openai | anthropic | openrouter
LLM_PROVIDER=google

# ── API Keys (set the ones you use) ──────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── Models ────────────────────────────────────────────────────────────────────
# Orchestrator uses a lighter model for routing decisions
ORCHESTRATOR_MODEL=gemini-2.5-flash-lite
# Sub-agents (classification, landing, hosting, embedded) use the main model
AGENT_MODEL=gemini-2.5-flash

# ── Docker image naming ───────────────────────────────────────────────────────
OWC_IMAGE=open-web-catcher
OWC_WEB_IMAGE=open-web-catcher-web
OWC_TAG=latest

# Internal observability and cost tracking
OBSERVABILITY_ENABLED=true
OBSERVABILITY_PROJECT_NAME=open-web-catcher
OBSERVABILITY_DEFAULT_DATASET_NAME=open-web-catcher-runs
OBSERVABILITY_DATASET_DIR=data/datasets
UI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional local cost estimates by model:
# MODEL_PRICING_JSON={"gemini-2.5-flash":{"provider":"google","input_per_million":0.0,"output_per_million":0.0},"gemini-2.5-flash-lite":{"provider":"google","input_per_million":0.0,"output_per_million":0.0}}
# Auto-sync pricing from provider APIs where supported (currently openrouter)
PROVIDER_PRICING_SYNC_ENABLED=true
PROVIDER_PRICING_TIMEOUT_SECONDS=15
PROVIDER_PRICING_MAX_MODELS=300

# ── IPInfo (provider lookup — 50k req/month free without token) ───────────────
IPINFO_TOKEN=

# ── Cloudinary (screenshot hosting for visual evidence) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# If your account uses an upload preset (e.g. unsigned uploads), set it here.
CLOUDINARY_UPLOAD_PRESET=
# Optional: set true when using unsigned uploads with an upload preset.
# CLOUDINARY_UNSIGNED_UPLOAD=false

# ── Internal services (set automatically in the container) ───────────────────
# These defaults match the single-container setup and rarely need changing.
# MCP_BROWSER_MODE=isolated
# BROWSER_WS_ENDPOINT=ws://localhost:9222
# Optional: force a specific Chrome version instead of auto-resolving latest stable.
# OWC_CHROME_VERSION=
# OWC_CHROME_VERSION_API_URL=https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json
# OWC_CHROME_VERSION_FETCH_TIMEOUT_MS=6000
# OWC_CHROME_VERSION_FALLBACK=146.0.0.0
# Optional diagnostics for browser fingerprint setup.
# OWC_DEBUG_FINGERPRINT=false
# MCP_SERVER_URL=http://localhost:3001
# DATABASE_URL=postgresql+psycopg2://owc:owc@localhost:5432/owc

# ── DeepEval / OpenRouter judge (local eval only, not used in container) ──────
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Logging ───────────────────────────────────────────────────────────────────
# uBlock Origin Lite (MV3) - default adblocking engine
# OWC_UBOL_ENABLED=true
# OWC_UBOL_EXTENSION_DIR=/app/tools/puppeteer/extensions/ubol
# OWC_UBOL_EXTENSION_DIR_PLAYWRIGHT=/app/tools/playwright/extensions/ubol
# OWC_UBOL_DEFAULT_FILTERING=optimal
# Legacy Ghostery engine fallback (disabled by default when using uBOL)
# OWC_ADBLOCK_ENABLED=false
# Comma-separated hostnames to bypass adblock for fragile players while keeping global blocking.
# Example: OWC_ADBLOCK_ALLOWLIST_HOSTS=olympicstreams.co,stream.example.com
# OWC_ADBLOCK_ALLOWLIST_HOSTS=
# Disable filter categories that are too aggressive for your targets.
# OWC_ADBLOCK_EXCLUDED_CATEGORIES=nsfw,gambling
# OWC_ADBLOCK_CACHE_DIR=data/cache/adblocker
# OWC_ADBLOCK_CACHE_TTL_MS=86400000
# OWC_ADBLOCK_FILTERLIST_FETCH_TIMEOUT_MS=15000
# Auto-disable adblock when player/iframe requests are blocked or aborted, then retry navigation.
# OWC_ADBLOCK_AUTO_RECOVERY_ENABLED=true
# OWC_ADBLOCK_AUTO_RECOVERY_ON_ABORT=true
# OWC_ADBLOCK_AUTO_RECOVERY_RETRY=true
# Keep stream CORS patch off unless a specific site requires it.
# OWC_ENABLE_STREAM_CORS_PATCH=false
# OWC_STREAM_CORS_INCLUDE_CREDENTIALS=false

LOG_LEVEL=INFO
