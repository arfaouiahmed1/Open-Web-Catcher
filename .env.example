# Copy this file to .env and fill in your values.

# ── LLM ───────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Models ────────────────────────────────────────────────────────────────────
# Orchestrator uses a smaller model for routing decisions
ORCHESTRATOR_MODEL=gemini-2.5-flash-lite
# Sub-agents (classification, landing, hosting, embedded) use the full model
AGENT_MODEL=gemini-2.5-flash

# ── Docker image naming ───────────────────────────────────────────────────────
OWC_IMAGE=open-web-catcher
OWC_WEB_IMAGE=open-web-catcher-web
OWC_TAG=latest

# Internal observability and cost tracking
OBSERVABILITY_ENABLED=true
OBSERVABILITY_PROJECT_NAME=open-web-catcher
OBSERVABILITY_DEFAULT_DATASET_NAME=open-web-catcher-runs
OBSERVABILITY_DATASET_DIR=data/datasets
UI_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
# Optional local cost estimates by model:
# MODEL_PRICING_JSON={"gemini-2.5-flash":{"provider":"google","input_per_million":0.0,"output_per_million":0.0},"gemini-2.5-flash-lite":{"provider":"google","input_per_million":0.0,"output_per_million":0.0}}

# ── IPInfo (provider lookup — 50k req/month free without token) ───────────────
IPINFO_TOKEN=

# ── Cloudinary (screenshot hosting for visual evidence) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Internal services (set automatically in the container) ───────────────────
# These defaults match the single-container setup and rarely need changing.
# MCP_BROWSER_MODE=isolated
# BROWSER_WS_ENDPOINT=ws://localhost:9222
# MCP_SERVER_URL=http://localhost:3000
# DATABASE_URL=postgresql+psycopg2://owc:owc@localhost:5432/owc

# ── Logging ───────────────────────────────────────────────────────────────────
# Ghostery adblocker + filterlist cache
# OWC_GHOSTERY_NETWORK_FILTERING=true
# OWC_GHOSTERY_COSMETIC_FILTERING=true
# OWC_ADBLOCK_CACHE_DIR=data/cache/adblocker
# OWC_ADBLOCK_CACHE_TTL_MS=86400000
# OWC_ADBLOCK_FILTERLIST_FETCH_TIMEOUT_MS=15000

LOG_LEVEL=INFO
