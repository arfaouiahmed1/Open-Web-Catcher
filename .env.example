# Copy this file to .env and fill in your values.

# ── LLM ───────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Models ────────────────────────────────────────────────────────────────────
# Orchestrator uses a smaller model for routing decisions
ORCHESTRATOR_MODEL=gemini-2.5-flash-lite-preview-05-20
# Sub-agents (classification, landing, hosting, embedded) use the full model
AGENT_MODEL=gemini-2.5-flash-preview-05-20

# ── Docker image naming ───────────────────────────────────────────────────────
OWC_IMAGE=open-web-catcher
OWC_TAG=latest

# ── LangSmith Self-Hosted (Docker Compose, no Kubernetes) ─────────────────────
# Self-hosted LangSmith is an Enterprise add-on from LangChain and requires a
# valid LANGSMITH_LICENSE_KEY for the LangSmith services to start correctly.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=open-web-catcher
LANGSMITH_ENDPOINT=http://langchain-frontend:1980
LANGSMITH_UI_URL=http://localhost:1980
LANGSMITH_LICENSE_KEY=your-self-hosted-langsmith-license-key
_LANGSMITH_IMAGE_VERSION=0.11.4
AUTH_TYPE=none
API_KEY_SALT=change-me-if-you-enable-auth
TRACE_TIER_TTL_DURATION_SEC_MAP={"longlived":34560000,"shortlived":1209600}

# Backwards-compatible aliases still supported if your environment already uses them:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=open-web-catcher

# ── IPInfo (provider lookup — 50k req/month free without token) ───────────────
IPINFO_TOKEN=

# ── Cloudinary (screenshot hosting for visual evidence) ──────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── Internal services (set automatically in the container) ───────────────────
# These defaults match the single-container setup and rarely need changing.
# MCP_BROWSER_MODE=isolated
# BROWSER_WS_ENDPOINT=ws://localhost:9222
# MCP_SERVER_URL=http://localhost:3000
# DATABASE_URL=postgresql+psycopg2://owc:owc@localhost:5432/owc

# ── Logging ───────────────────────────────────────────────────────────────────
# Ghostery adblocker + filterlist cache
# OWC_GHOSTERY_NETWORK_FILTERING=true
# OWC_GHOSTERY_COSMETIC_FILTERING=true
# OWC_ADBLOCK_CACHE_DIR=data/cache/adblocker
# OWC_ADBLOCK_CACHE_TTL_MS=86400000
# OWC_ADBLOCK_FILTERLIST_FETCH_TIMEOUT_MS=15000

LOG_LEVEL=INFO
