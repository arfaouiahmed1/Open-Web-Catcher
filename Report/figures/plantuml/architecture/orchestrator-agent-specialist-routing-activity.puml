@startuml orchestrator_agent_specialist_routing_activity
title Orchestrator Agent Activity with Specialist Calls

skinparam shadowing false
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam activity {
  BackgroundColor #EAF2FF
  BorderColor #4A6FA5
  ArrowColor #4A6FA5
  DiamondBackgroundColor white
  DiamondBorderColor #4A6FA5
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #7A5A00
}

start

partition "OrchestratorAgent" {
  :Receive seed URL;
  :Initialize PipelineState\n(url, run_id, queues, results);
  :Emit pipeline_started event;
  :Check long-memory hints\nas soft routing guidance;
}

partition "Specialist call" {
  :Call Classification specialist\nClassificationAgent.run(url);
}

partition "OrchestratorAgent" {
  :Read ClassificationResult\n(page_type, confidence, reasoning);
  if (page_type == landing_page?) then (yes)
    :Build landing HandoffContext\n(root URL, reasoning, memory hints);
    :Dispatch Landing specialist;
  elseif (page_type == host_page?) then (yes)
    :Queue root URL as hosting target;
  elseif (page_type == embed_video_page?) then (yes)
    :Queue root URL as embedded target\nonly if direct-player evidence is valid;
  else (other or failed)
    :Preserve classification reason;
    :Skip browser specialists;
  endif
}

partition "Specialist call" {
  if (landing specialist needed?) then (yes)
    :Call Landing specialist\nLandingPageAgent.run(root URL, handoff);
  else (no)
  endif
}

partition "OrchestratorAgent" {
  if (LandingResult returned?) then (yes)
    :Normalize landing JSON\ninto MatchInfo[] and ExtractionResult;
    :Queue verified hosting URLs;
    :Preserve direct stream URLs\nand explicit player hints;
  else (no)
  endif
}

partition "OrchestratorAgent" {
  while (pending_hosting_urls not empty?) is (yes)
    :Build hosting HandoffContext\nfor each queued target;
    :Apply max_parallel_hosting_pages limit;

    partition "Specialist call" {
      :Call Hosting specialists\nHostingPageAgent.run(target, handoff);
    }

    partition "OrchestratorAgent" {
      :Collect hosting ExtractionResult[];
      :Append streams, screenshots,\nserver rows, diagnostics;
      if (hosting returned explicit embedded URLs?) then (yes)
        :Queue embedded/player targets;
      else (no)
      endif
      :Clear processed hosting queue;
    }
  endwhile (no)
}

partition "OrchestratorAgent" {
  while (pending_embedded_urls not empty?) is (yes)
    :Validate embedded targets\nagainst hosting/player evidence;
    :Build embedded HandoffContext\nfor each valid player URL;

    partition "Specialist call" {
      :Call Embedded specialists\nEmbeddedPageAgent.run(player URL, handoff);
    }

    partition "OrchestratorAgent" {
      :Collect embedded ExtractionResult[];
      :Append streams, screenshots,\nplayer state, blocker diagnostics;
      :Clear processed embedded queue;
    }
  endwhile (no)
}

partition "OrchestratorAgent" {
  :Aggregate specialist outcomes\n(matches, streams, screenshots, failures);
  :Collect provider-like stream URLs;
  if (stream URLs found?) then (yes)
    :Run provider analysis tool\nIPInfoTool._arun(stream_urls);
    :Run email draft tool\nEmailTool._arun(root URL, providers, extractions);
  else (no)
    :Skip provider analysis\nand takedown drafts;
  endif

  :Compute final pipeline status\n(success, partial, timeout,\nno_hosting_pages, no_streams, failed);
  :Build PipelineResult;
  :Emit pipeline_finished event;
}

:Return PipelineResult;
stop

legend right
  This diagram is centered on the OrchestratorAgent.
  Classification, Landing, Hosting, and Embedded are specialist calls.
  Their internal browser loops are intentionally hidden here.
endlegend
@enduml
