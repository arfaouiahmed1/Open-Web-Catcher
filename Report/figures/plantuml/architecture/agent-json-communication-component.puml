@startuml agent_json_communication_component
title Agent JSON Communication - UML Component Diagram

allowmixing
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 180
skinparam component {
  BackgroundColor #F2F7FF
  BorderColor #3A5F8A
}
skinparam artifact {
  BackgroundColor #FFF8E7
  BorderColor #7A5A00
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #4A6FA5
}

component "OrchestratorAgent\nrouting + queue owner" as Orchestrator

component "Classification specialist" as Classification
component "Landing specialist" as Landing
component "Hosting specialist" as Hosting
component "Embedded specialist" as Embedded
component "Provider analysis tool" as Provider
component "Email generator tool" as Email

interface "route decision" as IRoute
interface "landing handoff" as ILanding
interface "hosting handoff" as IHosting
interface "embedded handoff" as IEmbedded
interface "stream enrichment" as IProvider
interface "review draft" as IEmail

artifact "ClassificationResult JSON\nurl, page_type,\nconfidence, reasoning" as ClassificationJSON
artifact "HandoffContext JSON\nroot_url, target_url,\npage_type, route_source,\nrequired_evidence, hints" as HandoffJSON
artifact "Landing output JSON\nhosting_pages[],\ndirect_stream_urls[],\nsite_patterns,\nrejected_urls" as LandingJSON
artifact "Hosting output JSON\ndecision, servers[],\nstreaming_urls[],\nembedded_urls[], diagnostics" as HostingJSON
artifact "Embedded output JSON\nservers[], all_stream_urls[],\nplayer state, screenshots,\nblocker/no-stream reason" as EmbeddedJSON
artifact "ProviderInfo[] JSON\nstream_url, hostname,\nprovider, abuse_email,\nwhois evidence" as ProviderJSON
artifact "TakedownEmail[] JSON\nprovider, contact,\nsubject, body,\nstream and screenshot evidence" as EmailJSON
artifact "PipelineResult JSON\nclassification, matches,\nextractions, streams,\nproviders, emails, final status" as PipelineResult

Orchestrator --> Classification : run(url)
Classification --> IRoute
IRoute --> ClassificationJSON
ClassificationJSON --> Orchestrator : normalized route input

Orchestrator --> HandoffJSON : builds from state\nand evidence
HandoffJSON --> ILanding
ILanding --> Landing : run(root URL, handoff)
Landing --> LandingJSON : returns raw JSON
LandingJSON --> Orchestrator : normalize to\nMatchInfo[] + ExtractionResult

HandoffJSON --> IHosting
IHosting --> Hosting : run(hosting URL, handoff)
Hosting --> HostingJSON : returns raw JSON
HostingJSON --> Orchestrator : normalize streams,\nserver rows, embedded handoffs

HandoffJSON --> IEmbedded
IEmbedded --> Embedded : run(player URL, handoff)
Embedded --> EmbeddedJSON : returns raw JSON
EmbeddedJSON --> Orchestrator : normalize stream or\nblocker evidence

Orchestrator --> IProvider : stream_urls[]
IProvider --> Provider
Provider --> ProviderJSON
ProviderJSON --> Orchestrator

Orchestrator --> IEmail : infringing_url +\nproviders + extractions
IEmail --> Email
Email --> EmailJSON
EmailJSON --> Orchestrator

Orchestrator --> PipelineResult : aggregate final contract

note bottom of Orchestrator
  Agents do not exchange JSON directly with each other.
  The orchestrator owns every route, queue, normalization step,
  and final aggregate.
end note

note bottom of HandoffJSON
  The handoff is JSON-shaped task context rendered into the child prompt.
  It carries evidence and constraints, not private model reasoning.
end note
@enduml
