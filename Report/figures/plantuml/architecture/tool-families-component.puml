@startuml tool_families_component
title Browser Tool Families - UML Component Diagram

allowmixing
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center
skinparam wrapWidth 170
skinparam component {
  BackgroundColor #F2F7FF
  BorderColor #3A5F8A
}
skinparam node {
  BackgroundColor #F7FAFC
  BorderColor #2F4F6F
}
skinparam artifact {
  BackgroundColor #FFF8E7
  BorderColor #7A5A00
}
skinparam database {
  BackgroundColor #F5F5F5
  BorderColor #666666
}

component "Browser-facing specialists\nClassification / Landing / Hosting / Embedded" as Agents
component "Agent tool binding\nagent_tools(profile)" as Binding
component "MCP browser client" as MCPClient

node "Profile-scoped browser tools" as Profiles {
  component "Inspection and context\ninspect, inspect_landing,\ninspect_hosting, inspect_embedded,\nquery/detail/frame tree" as Inspection
  component "Navigation and interaction\nnavigate, open_url, interact,\nscroll, wait, play_media" as Navigation
  component "Evidence and media\nscreenshot, media state,\nharvest/capture streams,\nnetwork diagnostics" as Evidence
  component "Memory and site hints\nmemory_lookup,\nmemory_update,\nplaybook hints" as MemoryTools
}

node "Browser runtime" as BrowserRuntime {
  component "Puppeteer + Chrome\nprimary runtime" as Puppeteer
  component "Playwright + Chrome\nalignment/runtime checks" as Playwright
  component "Browser policy\nprofile state, popup handling,\nproxy, fingerprint controls" as Policy
}

database "ToolResultCache\nread-only observations only" as Cache
artifact "Working state\nshort memory, latest observation,\ncontinuation capsule" as WorkingState
artifact "Reviewable outputs\nselectors, frame paths,\nscreenshots, stream URLs,\ndiagnostics" as Outputs

Agents --> Binding : request allowed tools
Binding --> MCPClient : bind profile-specific tool list
MCPClient --> Inspection : broad and scoped reads
MCPClient --> Navigation : page-changing actions
MCPClient --> Evidence : proof and media extraction
MCPClient --> MemoryTools : soft site hints

Inspection --> Cache : cacheable read-only result
Cache --> Agents : reuse observation when unchanged
Navigation --> Cache : invalidates stale observations
Evidence --> Outputs : screenshots and stream evidence
Inspection --> WorkingState : candidates and page state
Navigation --> WorkingState : changed URL/DOM state
MemoryTools --> WorkingState : hints, selectors, playbooks

Inspection --> Puppeteer
Navigation --> Puppeteer
Evidence --> Puppeteer
MemoryTools --> Puppeteer
Puppeteer --> Policy
Playwright --> Policy

note bottom of Cache
  Cache is safe only for non-mutating observations.
  Browser-changing tools such as navigation, click, scroll,
  typing, and play invalidate stale context.
end note

note bottom of Profiles
  Tool families are not separate agents.
  They are profile-scoped operations that each specialist can request.
end note
@enduml
