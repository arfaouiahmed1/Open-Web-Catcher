@startuml fig_04_03_end_to_end_agent_pipeline_activity
title End-to-End Agent Pipeline - General Activity

skinparam shadowing false
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam activity {
  BackgroundColor #EAF2FF
  BorderColor #4A6FA5
  ArrowColor #4A6FA5
  DiamondBackgroundColor white
  DiamondBorderColor #4A6FA5
  StartColor #2F6F4E
  EndColor #2F6F4E
}
skinparam partition {
  BackgroundColor #FAFBFF
  BorderColor #C9D6EA
}
skinparam note {
  BackgroundColor #FFF8E7
  BorderColor #7A5A00
}

start

partition "Operator and API" {
  :Operator submits seed URL;
  :Start workflow run\nand create active trace;

  if (Runtime ready?) then (yes)
    :Call orchestrator;
  else (no)
    :Return blocking reason\n(browser, tool, or API setup);
    stop
  endif
}

partition "Orchestrator" {
  :Initialize pipeline state;
  :Read memory hints\nas soft guidance;
  :Call Classification specialist;

  if (Usable route?) then (yes)
    :Prepare bounded handoff\nand specialist work queues;
  else (no)
    :Record unknown / unsupported page;
  endif
}

if (Specialist route available?) then (yes)
  partition "Specialist Extraction" {
    repeat
      :Run next specialist path\nLanding, Hosting, or Embedded;
      :Browser runtime observes page\nnavigate, inspect, screenshot, extract;
      :Return typed JSON evidence;
      :Normalize result and update queues;
    repeat while (More hosting or embedded targets?) is (yes)
  }

  partition "Orchestrator" {
    :Aggregate evidence\nmatches, streams, screenshots, failures;
  }
else (no)
endif

partition "Provider and Email Stages" {
  if (Stream evidence found?) then (yes)
    :Run provider analysis\nfor stream hosts;
    :Generate reviewable\nemail drafts;
  else (no)
    :Skip provider analysis\nand email generation;
  endif
}

partition "Pipeline Result" {
  :Compute final status\nsuccess, partial, no-stream, blocked, or failed;
  :Build PipelineResult;
  :Expose run detail\nfor operator review;
}

stop

legend right
  This view merges the operational path and ownership view.
  The orchestrator owns routing, queues, normalization, and final status.
  Specialists perform bounded browser-facing work and return typed JSON only.
endlegend
@enduml
