@startuml orchestrator_activity_no_storage
title Orchestrator Agent - Activity Diagram (No Storage Lifelines)
skinparam shadowing false
start
:Receive seed URL and settings;
:Initialize in-memory PipelineState\nURL, run id, queues, results;
:Run ClassificationAgent;
if (page_type == landing_page?) then (yes)
  :Build landing handoff\nroot URL, reasoning, required evidence;
  :Run LandingPageAgent;
  :Normalize landing matches;
  :Queue verified hosting URLs;
  :Preserve direct stream URLs\nand player hints;
elseif (page_type == host_page?) then (yes)
  :Queue root URL as hosting target;
elseif (page_type == embed_video_page?) then (yes)
  :Queue root URL only when direct-player evidence is strong;
else (other or failed)
  :Record route reason in state;
endif

while (pending hosting URLs?) is (yes)
  :Build one hosting handoff per target;
  :Run HostingPageAgent tasks\nwithin concurrency limit;
  :Append hosting extraction results;
  if (explicit embedded URLs returned?) then (yes)
    :Queue verified embedded targets;
  else (no)
  endif
endwhile (no)

while (pending embedded URLs?) is (yes)
  :Build embedded handoffs;
  :Run EmbeddedPageAgent tasks\nwithin concurrency limit;
  :Append embedded extraction results;
endwhile (no)

:Collect provider-like stream URLs\nfrom extraction results;
if (streams found?) then (yes)
  :Run provider analysis;
  :Generate takedown email drafts;
else (no)
  :Skip provider and email stages;
endif
:Compute final status\nsuccess, partial, timeout, no streams, failed;
:Return PipelineResult;
stop
@enduml
