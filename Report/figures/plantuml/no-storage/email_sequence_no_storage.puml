@startuml email_sequence_no_storage
title Email Generator Tool - Sequence Diagram
hide footbox
skinparam shadowing false
actor "Orchestrator" as Orchestrator
control "EmailTool" as Tool
participant "generate_takedown_emails" as Generator
participant "_collect_stream_evidence" as Evidence
participant "channel helpers" as Channel

Orchestrator -> Tool: _arun(root URL,\nprovider_analysis, extraction_results)
Tool -> Tool: Deserialize ProviderInfo\nand ExtractionResult objects
Tool -> Generator: generate_takedown_emails(...)
Generator -> Evidence: collect stream, screenshot,\nserver, channel evidence
Evidence --> Generator: StreamEvidence[]
Generator -> Channel: normalize/infer channel names\nand rights reference URLs
Channel --> Generator: Channel metadata
Generator -> Generator: Group by channel,\nprovider, and abuse contact
Generator -> Generator: Build review-only subject/body\nwith evidence links
Generator --> Tool: TakedownEmail[]
Tool --> Orchestrator: JSON email drafts
@enduml
