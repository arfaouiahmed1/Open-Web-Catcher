@startuml provider_activity_no_storage
title Provider Analysis Tool - Activity Diagram (No Storage Lifelines)
skinparam shadowing false
start
:Receive extraction results;
:Collect and deduplicate stream URLs;
if (no provider-like streams?) then (yes)
  :Return empty provider list;
  stop
else (streams exist)
endif
:Group or dedupe by stream host;
while (unresolved host remains?) is (yes)
  :Resolve hostname and IP address;
  :Query IPInfo when token/config allows;
  :Enrich with RDAP/Whois abuse contact;
  :Build ProviderInfo row;
endwhile (done)
:Return ProviderInfo[] as JSON;
stop
@enduml
