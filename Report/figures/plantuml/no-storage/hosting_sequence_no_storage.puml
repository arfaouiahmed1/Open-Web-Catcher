@startuml hosting_sequence_no_storage
title Hosting Page Agent - Sequence Diagram (No Storage Lifelines)
hide footbox
skinparam shadowing false
actor "Orchestrator" as Orchestrator
control "HostingPageAgent" as Agent
participant "Prompt compiler" as Prompt
participant "hosting MCP tools" as Tools
participant "Gemini model" as LLM
participant "_normalize_hosting_output" as Normalize

Orchestrator -> Agent: run(hosting URL, hosting handoff)
Agent -> Prompt: Compile hosting prompt,\nsource-control contract, handoff
Prompt --> Agent: Layered prompt
Agent -> Tools: Open hosting profile
Agent -> Tools: Bootstrap navigate/context\nand inspect_hosting
Tools --> Agent: Player state, server frontier,\niframes, overlays, media clues

loop each same-content server/source target
  Agent -> LLM: Current player/source state
  LLM --> Agent: Activation or extraction plan
  Agent -> Tools: Dismiss blocking overlays if needed
  Agent -> Tools: Activate exact server/source/player target
  Tools --> Agent: Updated player state
  Agent -> Tools: screenshot + harvest/capture streams
  Tools --> Agent: Streams, iframe URLs,\ndiagnostics, screenshot URLs
end

Agent -> Normalize: Normalize server rows,\nstreams, embedded URLs, decision
Normalize --> Agent: Clean hosting payload

alt streams found
  Agent --> Orchestrator: ExtractionResult(status success,\nstreams and evidence)
else explicit embedded URL after iframe-local attempt
  Agent --> Orchestrator: ExtractionResult(status partial,\nembedded handoff)
else no stream or handoff
  Agent --> Orchestrator: ExtractionResult(status failed,\nfailure diagnostics)
end
@enduml
