@startuml classification_sequence_no_storage
title Classification Agent - Sequence Diagram (No Storage Lifelines)
hide footbox
skinparam shadowing false
actor "Orchestrator" as Orchestrator
control "ClassificationAgent" as Agent
participant "Prompt compiler" as Prompt
participant "classification MCP tools" as Tools
participant "Gemini model" as LLM
participant "JSON parser" as Parser

Orchestrator -> Agent: run(url)
Agent -> Prompt: Compile base policy,\nagent contract, runtime context
Prompt --> Agent: Layered prompt
Agent -> Tools: Open classification profile
Agent -> Tools: Bootstrap navigate/context inspect
Tools --> Agent: Rendered page signals

loop until classification JSON or tool budget ends
  Agent -> LLM: Messages + page signals + tool schema
  LLM --> Agent: Page-type reasoning or tool call
  alt tool call requested
    Agent -> Tools: navigate / inspect / query / interact / screenshot
    Tools --> Agent: Tool result
  else final answer
    LLM --> Agent: JSON-like classification output
  end
end

Agent -> Parser: parse_json_object(final_text)
Parser --> Agent: page_type, confidence, reasoning
Agent --> Orchestrator: ClassificationResult
@enduml
