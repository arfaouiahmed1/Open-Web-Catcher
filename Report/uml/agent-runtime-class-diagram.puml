@startuml
title Agent Runtime Class Diagram
left to right direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  BorderColor #4A4A4A
  ArrowColor #4A4A4A
}

class OrchestratorAgent {
  +run(url)
  +build_handoff(target_url, page_role)
  +route_specialists(state)
  +aggregate_result(state)
}

class ClassificationAgent {
  +classify(context)
}

class LandingPageAgent {
  +discover_candidates(context)
}

class HostingPageAgent {
  +activate_and_extract(context)
}

class EmbeddedPageAgent {
  +inspect_player(context)
}

class RunObserver {
  +emit_event(event)
  +record_tool_call(call)
  +record_model_call(call)
  +finish_status(status)
}

class PipelineState {
  +root_url
  +pending_hosting_pages
  +pending_embedded_urls
  +streams
  +screenshots
}

class HandoffContext {
  +target_url
  +page_role
  +route_source
  +known_candidates
  +evidence_checklist
}

class AgentLoopResult {
  +final_text
  +tool_calls
  +stop_reason
  +diagnostics
}

class PipelineResult {
  +final_status
  +classification
  +extractions
  +streams
  +providers
  +emails
}

class ClassificationResult {
  +page_type
  +confidence
  +route_reason
}

class ExtractionResult {
  +streams
  +screenshots
  +embedded_urls
  +diagnostics
}

class StreamURL {
  +url
  +source_page
  +evidence_type
}

class ProviderInfo {
  +host
  +ip
  +network
  +contacts
}

class TakedownEmail {
  +recipient
  +subject
  +evidence_refs
  +draft_body
}

OrchestratorAgent *-- PipelineState : owns
OrchestratorAgent ..> HandoffContext : creates
OrchestratorAgent ..> ClassificationAgent : routes
OrchestratorAgent ..> LandingPageAgent : routes
OrchestratorAgent ..> HostingPageAgent : routes
OrchestratorAgent ..> EmbeddedPageAgent : routes

ClassificationAgent ..> RunObserver : emits events
LandingPageAgent ..> RunObserver : emits events
HostingPageAgent ..> RunObserver : emits events
EmbeddedPageAgent ..> RunObserver : emits events

ClassificationAgent ..> AgentLoopResult : uses
LandingPageAgent ..> AgentLoopResult : uses
HostingPageAgent ..> AgentLoopResult : uses
EmbeddedPageAgent ..> AgentLoopResult : uses

ClassificationAgent --> ClassificationResult : returns
LandingPageAgent --> ExtractionResult : returns
HostingPageAgent --> ExtractionResult : returns
EmbeddedPageAgent --> ExtractionResult : returns

ExtractionResult *-- StreamURL : contains
StreamURL --> ProviderInfo : enriched by
ProviderInfo --> TakedownEmail : supports

PipelineResult *-- ClassificationResult
PipelineResult *-- ExtractionResult
PipelineResult o-- ProviderInfo : provider summary
PipelineResult o-- TakedownEmail : email drafts

@enduml
